# Frontend Environment Variables Example
# Copy this file to .env and fill in the actual values

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=v1

# AWS Configuration (if needed for frontend SDK)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_IDENTITY_POOL_ID=

# Environment
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_DOCUMENT_UPLOAD=true
VITE_ENABLE_VIDEO_CONSULTATION=true

# Application Configuration
VITE_APP_NAME=Ayurveda AI Platform
VITE_SUPPORT_EMAIL=support@ayurveda-ai.com
