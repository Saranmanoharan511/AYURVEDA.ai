# Backend Environment Variables Example
# Copy this file to .env and fill in the actual values

# Application Settings
APP_NAME=Ayurveda AI Platform
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database - Neon PostgreSQL
# For local development with docker-compose:
# DATABASE_URL=postgresql://ayurveda_user:ayurveda_password@postgres:5432/ayurveda_ai
# For Neon PostgreSQL (production/staging):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://ayurveda_user:ayurveda_password@postgres:5432/ayurveda_ai

# AWS Configuration
AWS_REGION=us-east-1

# S3 Configuration
S3_BUCKET_NAME=<your-s3-bucket-name>

# SQS Configuration
SQS_DOCUMENT_QUEUE_URL=<your-document-queue-url>
SQS_EMAIL_QUEUE_URL=<your-email-queue-url>

# Cognito Configuration
COGNITO_USER_POOL_ID=<your-user-pool-id>
COGNITO_CLIENT_ID=<your-client-id>
COGNITO_REGION=us-east-1

# Bedrock Configuration
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0  # AWS Nova Micro for cost efficiency
BEDROCK_GUARDRAIL_ID=<your-guardrail-id>
BEDROCK_GUARDRAIL_VERSION=DRAFT

# SES Configuration
SES_FROM_EMAIL=<your-from-email>
SES_REGION=us-east-1

# Embedding Configuration (Sprint 5)
EMBEDDING_PROVIDER=bedrock  # Options: openai, bedrock, local
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0  # Amazon Titan Text Embeddings V2
EMBEDDING_DIMENSIONS=1024  # Embedding vector dimensions for Titan V2
OPENAI_API_KEY=<your-openai-api-key>  # Required if using OpenAI

# Textract Configuration (Sprint 5)
# Textract uses AWS credentials from AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY

# CloudWatch Configuration
CLOUDWATCH_LOG_GROUP=/ayurveda-ai/backend

# Security
SECRET_KEY=<your-secret-key-change-in-production>

# Rate Limiting Configuration (Sprint 7)
RATE_LIMIT_PER_MINUTE=30
REDIS_URL=memory://  # Use Redis URL for production, memory:// for development

# AWS Credentials (for Code-Only Mode - will be replaced with IAM roles in production)
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>

# CloudWatch Alarms (Sprint 7)
CLOUDWATCH_ERROR_THRESHOLD=5  # Errors per minute
CLOUDWATCH_LATENCY_THRESHOLD_P95=2000  # 95th percentile latency in ms
CLOUDWATCH_LATENCY_THRESHOLD_P99=5000  # 99th percentile latency in ms

# DLQ Configuration (Sprint 7)
DLQ_DOCUMENT_QUEUE_URL=<your-dlq-document-queue-url>
DLQ_EMAIL_QUEUE_URL=<your-dlq-email-queue-url>
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60

# Admin Configuration (Sprint 7)
ADMIN_EMAIL=<admin@example.com>
DEFAULT_DOCTOR_STATUS=active
DEFAULT_PATIENT_STATUS=active

# System Configuration (Sprint 7)
ENABLE_AUDIT_LOGGING=True
ENABLE_ANALYTICS=True
SYSTEM_TIMEZONE=Asia/Kolkata
