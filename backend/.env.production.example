# Backend Environment Variables - Production
# Copy this file to .env.production and fill in the actual values

# Application Settings
APP_NAME=Ayurveda AI Platform
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# CORS Settings
ALLOWED_ORIGINS=["https://yourdomain.com"]

# Database - Neon PostgreSQL Production
DATABASE_URL=<your-production-neon-database-url>

# AWS Configuration
AWS_REGION=us-east-1

# S3 Configuration
S3_BUCKET_NAME=<your-production-s3-bucket-name>

# SQS Configuration
SQS_DOCUMENT_QUEUE_URL=<your-production-document-queue-url>
SQS_EMAIL_QUEUE_URL=<your-production-email-queue-url>

# Cognito Configuration
COGNITO_USER_POOL_ID=<your-production-user-pool-id>
COGNITO_CLIENT_ID=<your-production-client-id>
COGNITO_REGION=us-east-1

# Bedrock Configuration
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0  # AWS Nova Micro for cost efficiency
BEDROCK_GUARDRAIL_ID=<your-guardrail-id>
BEDROCK_GUARDRAIL_VERSION=DRAFT

# SES Configuration
SES_FROM_EMAIL=<your-production-from-email>
SES_REGION=us-east-1

# CloudWatch Configuration
CLOUDWATCH_LOG_GROUP=/ayurveda-ai/backend-production

# Security
SECRET_KEY=<your-production-secret-key>

# Embedding Configuration (Sprint 5)
EMBEDDING_PROVIDER=bedrock  # Options: openai, bedrock, local
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0  # Amazon Titan Text Embeddings V2
EMBEDDING_DIMENSIONS=1024  # Embedding vector dimensions for Titan V2
OPENAI_API_KEY=<your-openai-api-key>  # Required if using OpenAI

# Rate Limiting Configuration (Sprint 7)
RATE_LIMIT_PER_MINUTE=60  # Higher limit for production
REDIS_URL=redis://<your-redis-host>:6379/0  # Use actual Redis in production

# CloudWatch Alarms (Sprint 7)
CLOUDWATCH_ERROR_THRESHOLD=10  # Errors per minute
CLOUDWATCH_LATENCY_THRESHOLD_P95=2000  # 95th percentile latency in ms
CLOUDWATCH_LATENCY_THRESHOLD_P99=5000  # 99th percentile latency in ms

# DLQ Configuration (Sprint 7)
DLQ_DOCUMENT_QUEUE_URL=<your-production-dlq-document-queue-url>
DLQ_EMAIL_QUEUE_URL=<your-production-dlq-email-queue-url>
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60

# Admin Configuration (Sprint 7)
ADMIN_EMAIL=<admin@example.com>
DEFAULT_DOCTOR_STATUS=active
DEFAULT_PATIENT_STATUS=active

# System Configuration (Sprint 7)
ENABLE_AUDIT_LOGGING=True
ENABLE_ANALYTICS=True
SYSTEM_TIMEZONE=Asia/Kolkata
