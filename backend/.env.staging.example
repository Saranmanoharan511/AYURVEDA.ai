# Backend Environment Variables - Staging
# Copy this file to .env.staging and fill in the actual values

# Application Settings
APP_NAME=Ayurveda AI Platform
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=staging

# CORS Settings
ALLOWED_ORIGINS=["https://staging.yourdomain.com"]

# Database - Neon PostgreSQL Staging
DATABASE_URL=<your-staging-neon-database-url>

# AWS Configuration
AWS_REGION=us-east-1

# S3 Configuration
S3_BUCKET_NAME=<your-staging-s3-bucket-name>

# SQS Configuration
SQS_DOCUMENT_QUEUE_URL=<your-staging-document-queue-url>
SQS_EMAIL_QUEUE_URL=<your-staging-email-queue-url>

# Cognito Configuration
COGNITO_USER_POOL_ID=<your-staging-user-pool-id>
COGNITO_CLIENT_ID=<your-staging-client-id>
COGNITO_REGION=us-east-1

# Bedrock Configuration
BEDROCK_MODEL_ID=<your-bedrock-model-id>

# SES Configuration
SES_FROM_EMAIL=<your-staging-from-email>
SES_REGION=us-east-1

# CloudWatch Configuration
CLOUDWATCH_LOG_GROUP=/ayurveda-ai/backend-staging

# Security
SECRET_KEY=<your-staging-secret-key>
